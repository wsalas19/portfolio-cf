{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-cf",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://portfolio-cf.wsalas.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "ffa407db7e064830b8e06d9476bd80d2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "portfolio-cf-content"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
