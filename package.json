{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test \"tests/*.test.mjs\"",
    "gen:content": "node scripts/generate-content.mjs",
    "predev": "pnpm gen:content",
    "prebuild": "pnpm gen:content",
    "predev:vinext": "pnpm gen:content",
    "prebuild:vinext": "pnpm gen:content",
    "postinstall": "pnpm gen:content",
    "clean:git": "git reset --hard HEAD && git clean -fd",
    "clean:build": "rm -rf .next node_modules/.cache",
    "clean:all": "pnpm run clean:git && pnpm run clean:build",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.2.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@vinext/cloudflare": "^1.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.4.10",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.2",
    "lucide-react": "^1.61.0",
    "motion": "^12.40.0",
    "next": "^15.5.28",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.50.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "vinext": "^1.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "type": "module"
}
