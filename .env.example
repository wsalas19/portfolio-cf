# Resend Configuration (use Cloudflare Workers Secrets in production)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=resend-from-email
RESEND_TO_EMAIL=resend-to-email

# Site Configuration
NEXT_PUBLIC_SITE_URL=prod-site-url

# TwtAPI Configuration
TWTAPI_KEY=your-twtapi-key-here

# Development Caching (optional)
# Set to 'true' to disable caching during development
DISABLE_CACHE=true
ADMIN_PASSWORD=''
ADMIN_SECRET=''
GITHUB_TOKEN=''

GITHUB_REPO=wsalas19/portfolio-cf
GITHUB_BRANCH=master
